arch="arm64"
platform="rockchip64"

bootloader="u-boot"
boot_mode="extlinux"
bootargs="console=ttyFIQ0,1500000 console=tty1 consoleblank=0 root=LABEL=rootfs rootfstype=ext4 rootwait rw"
bootloader_url="https://github.com/u-boot/u-boot"
bootloader_branch="v2025.10"
bootloader_config="generic-rk3576_defconfig"
bootloader_patchdir="100ask-dshanpi-a1/${bootloader_branch}"

atf_compile="no"
rkbin="yes"
soc="rk3576"
# Armbian pins RK3576 DDR v1.08 because v1.09 fails to boot on some boards.
# Keep BL31 from the current pinned rkbin revision and extract only this blob
# from its historical revision.
rkbin_tpl_bin="bin/rk35/rk3576_ddr_lp4_2112MHz_lp5_2736MHz_v1.08.bin"
rkbin_tpl_revision="57296ad286255d98a3d409036a4b8560b6013b7d"

kernel_group="rockchip64-bsp"
dtb_name="rockchip/rk3576-100ask-dshanpi-a1"
initrd="yes"

rootfs_arch="aarch64"

part_table="gpt"
boot_size="256"
eth_interface="eth0 eth1"
serial_console="ttyFIQ0"
serial_baud="1500000"
boot_timeout="1"
serial_getty="yes"
mdev_coldplug="yes"

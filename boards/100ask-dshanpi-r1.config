arch="arm64"
platform="rockchip64"

bootloader="u-boot"
boot_mode="extlinux"
bootargs="console=ttyS2,1500000 console=tty1 consoleblank=0 root=PARTLABEL=rootfs rootfstype=ext4 rootwait rw loglevel=8"
bootloader_url="https://github.com/u-boot/u-boot"
bootloader_branch="v2025.10"
bootloader_config="100ask-dshanpi-r1_defconfig"
bootloader_patchdir="100ask-dshanpi-r1/${bootloader_branch}"

atf_compile="no"
rkbin="yes"
soc="rk3568"

kernel_url="https://github.com/chainsx/rockchip-kernel.git"
kernel_branch="develop-6.6"
kernel_config="linux-rockchip64-bsp.config"
dtb_name="rockchip/rk3568-100ask-dshanpi-r1"
initrd="yes"

rootfs_arch="aarch64"

part_table="gpt"
boot_size="256"
eth_interface="eth0 eth1"

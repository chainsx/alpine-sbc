arch="arm64"
platform="amlogic"

bootloader="u-boot"
boot_mode="extlinux"
bootargs="console=ttyAML0,115200 console=tty1 consoleblank=0 root=LABEL=rootfs rootwait rootfstype=ext4 splash=verbose coherent_pool=2M"
bootloader_url="https://github.com/u-boot/u-boot.git"
bootloader_branch="v2025.10"
bootloader_config="khadas-vim3_defconfig"
bootloader_patchdir="khadas-vim3/${bootloader_branch}"

atf_compile="no"
amlogic_boot_fip="yes"
soc="a311d"

kernel_group="amlogic-lts"
dtb_name="amlogic/meson-g12b-a311d-khadas-vim3"
rootfs_arch="aarch64"
initrd="yes"

part_table="msdos"
boot_size="256"
eth_interface="eth0"
serial_console="ttyAML0"
serial_baud="115200"
boot_timeout="1"
serial_getty="yes"
mdev_coldplug="yes"

arch="arm64"
platform="rockchip64"

bootloader="u-boot"
boot_mode="extlinux"
bootargs="console=ttyS2,1500000 console=tty1 consoleblank=0 root=LABEL=rootfs rootfstype=ext4 rootwait rw"
bootloader_url="https://github.com/u-boot/u-boot"
bootloader_branch="v2025.10"
# This board defconfig and its U-Boot-specific DT overlay are supplied below
# patches/u-boot/v2025.10/firefly-rk3568-roc-pc/files/.
bootloader_config="roc-pc-rk3568_defconfig"
bootloader_patchdir="firefly-rk3568-roc-pc/${bootloader_branch}"

atf_compile="no"
rkbin="yes"
soc="rk3568"

kernel_group="rockchip64-bsp"
dtb_name="rockchip/rk3568-roc-pc"
rootfs_arch="aarch64"
initrd="yes"

part_table="gpt"
boot_size="256"
eth_interface="eth0 eth1"
serial_console="ttyS2"
serial_baud="1500000"
boot_timeout="1"
serial_getty="yes"
mdev_coldplug="yes"

# Generated by alpine-sbc.  Package layout follows Alpine's main/linux-lts.
_flavor="@FLAVOR@"
_abi_release="@ABI_RELEASE@"

pkgname="linux-$_flavor"
pkgver="@PKGVER@"
pkgrel="@PKGREL@"
pkgdesc="Linux kernel for alpine-sbc @BOARD@"
url="@KERNEL_URL@"
arch="@APK_ARCH@"
license="GPL-2.0-only"
depends="initramfs-generator"
_depends_dev="linux-headers=$pkgver-r$pkgrel perl gmp-dev mpc1-dev mpfr-dev elfutils-dev bash flex bison zstd"
options="!check !strip !tracedeps !archcheck"
subpackages="$pkgname-dev:_dev $pkgname-doc:_doc:noarch linux-headers:_headers"
source=""

package() {
	depends="$depends linux-firmware-any"
	local external_src="$startdir/kernel-bin"
	[ -d "$external_src/lib/modules/$_abi_release" ] \
		|| die "missing staged modules for $_abi_release"
	mkdir -p "$pkgdir"
	cp -a "$external_src"/. "$pkgdir"/
}

_dev() {
	pkgdesc="Headers and scripts for third-party modules for the $_flavor kernel"
	depends="$_depends_dev"
	local external_src="$startdir/kernel-dev-bin"
	[ -d "$external_src/usr/src/linux-headers-$_abi_release" ] \
		|| die "missing staged development headers for $_abi_release"
	mkdir -p "$subpkgdir"
	cp -a "$external_src"/. "$subpkgdir"/
}

_doc() {
	pkgdesc="Linux kernel documentation"
	depends=""
	local external_src="$startdir/kernel-doc-bin"
	[ -d "$external_src/usr/share/doc" ] || die "missing staged kernel documentation"
	mkdir -p "$subpkgdir"
	cp -a "$external_src"/. "$subpkgdir"/
}

_headers() {
	pkgdesc="Linux system headers generated from the @BOARD@ kernel source"
	depends=""
	local external_src="$startdir/kernel-headers-bin"
	[ -s "$external_src/usr/include/linux/version.h" ] \
		|| die "missing staged Linux UAPI headers"
	mkdir -p "$subpkgdir"
	cp -a "$external_src"/. "$subpkgdir"/
}
